# Copy this file to `.env` and fill in what you want to use.
# With the private GCP source switch off, the app picks a provider by priority:
# Ollama -> Gemini -> Groq.
# If none is set (or the chosen one fails) it falls back to a local model,
# and finally to the offline rule-based parser. Voice needs no key at all.

# --- 1. Local model via Ollama (recommended: no key, no limits) ---
# Install Ollama (https://ollama.com), pull a model, then set it here.
# Good options: qwen3:8b (accurate) or qwen2.5:7b (faster).
OLLAMA_MODEL=qwen3:8b
# Optional: override the endpoint or the local fallback model.
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_FALLBACK_MODEL=qwen3:8b

# --- 2. Gemini (cloud, optional) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- 3. Groq (cloud, optional) - free key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text model size (optional): tiny|base|small|medium ---
# Only used by the local faster-whisper path.
# WHISPER_MODEL=small

# --- AI handwritten bill assistant ---
# `fake` is deterministic and useful for UI/API development without a vision
# model. Use the structured Review screen to fill the extracted draft.
BILL_AI_BACKEND=fake
# To read real handwritten bill photos locally, switch to Ollama and choose a
# vision-capable model. gemma3:4b is the tested option for an 8 GB GPU.
# BILL_AI_BACKEND=ollama
# BILL_OLLAMA_MODEL=gemma3:4b
# BILL_OLLAMA_URL=http://localhost:11434/api/chat
# BILL_OLLAMA_TIMEOUT=180
# BILL_OLLAMA_NUM_CTX=8192
# For higher-accuracy handwriting extraction with the configured Gemini key:
# BILL_AI_BACKEND=gemini
# BILL_GEMINI_MODEL=gemini-3.6-flash
# BILL_GEMINI_TIMEOUT=120

# --- Private Google Cloud provider configuration ---
# Enabling Google Cloud is intentionally NOT an environment setting. Only the
# repository owner can change `GCP_ENABLED` inside app/config.py and restart the
# service. With that constant False, all settings below are ignored and the
# original Ollama/faster-whisper/edge-tts paths continue to work.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_VERTEX_LOCATION=global
# GCP_VERTEX_MODEL=gemini-3.6-flash
# GCP_VERTEX_TIMEOUT=120
# GCP_STT_LOCATION=global
# GCP_STT_MODEL=chirp_3
# GCP_STT_LANGUAGE_CODES=hi-IN,en-IN
# GCP_TTS_LOCATION=global
# GCP_TTS_VOICE_HI=hi-IN-Chirp3-HD-Leda
# GCP_TTS_VOICE_EN=en-IN-Chirp3-HD-Leda
# GCP_TTS_SPEAKING_RATE=1.08
# Optional Document AI OCR enrichment. Without this processor, Vertex Gemini
# still reads the original bill image directly.
# GCP_DOCUMENT_AI_LOCATION=us
# GCP_DOCUMENT_AI_PROCESSOR_ID=
# VOICE_MAX_AUDIO_BYTES=10485760

# Shop identity printed on professional sale invoices.
# DUKANBOOK_BUSINESS_NAME=Your Shop Name
# DUKANBOOK_BUSINESS_PHONE=9876543210
# DUKANBOOK_BUSINESS_GSTIN=
# BILL_MAX_SCAN_BYTES=10485760
# DUKANBOOK_SCAN_DIR=data/bill_scans

# ============================ Deployment ============================
# These matter when running in a container (see Dockerfile / render.yaml).
# Locally you can ignore all of them.

# Where the SQLite file lives. Point this at a persistent disk in production.
# DUKANBOOK_DB=/data/dukanbook.db

# Load the demo shop when the ledger is empty, so a fresh deploy is not blank.
# SEED_ON_START=1

# No Ollama in a container — set empty to skip the localhost fallback provider.
# OLLAMA_FALLBACK_MODEL=

# Backend overrides. By default the offline libraries win whenever they are
# installed (so a local `python run.py` stays fully offline), and the cloud is
# used only where they are absent, i.e. in the container. Override either way.
# EMBED_BACKEND=local|cloud   # RAG embeddings: fastembed vs Gemini
# STT_BACKEND=local|cloud     # speech-to-text: faster-whisper vs Groq
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_STT_MODEL=whisper-large-v3-turbo

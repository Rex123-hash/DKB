# Copy this file to `.env` and fill in what you want to use.
# The app picks a provider by priority: Ollama -> Gemini -> Groq.
# If none is set (or the chosen one fails) it falls back to a local model,
# and finally to the offline rule-based parser. Voice needs no key at all.

# --- 1. Local model via Ollama (recommended: no key, no limits) ---
# Install Ollama (https://ollama.com), pull a model, then set it here.
# Good options: qwen3:8b (accurate) or qwen2.5:7b (faster).
OLLAMA_MODEL=qwen3:8b
# Optional: override the endpoint or the local fallback model.
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_FALLBACK_MODEL=qwen3:8b

# --- 2. Gemini (cloud, optional) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- 3. Groq (cloud, optional) - free key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text model size (optional): tiny|base|small|medium ---
# Only used by the local faster-whisper path.
# WHISPER_MODEL=small

# ============================ Deployment ============================
# These matter when running in a container (see Dockerfile / render.yaml).
# Locally you can ignore all of them.

# Where the SQLite file lives. Point this at a persistent disk in production.
# DUKANBOOK_DB=/data/dukanbook.db

# Load the demo shop when the ledger is empty, so a fresh deploy is not blank.
# SEED_ON_START=1

# No Ollama in a container — set empty to skip the localhost fallback provider.
# OLLAMA_FALLBACK_MODEL=

# Backend overrides. Both default to the cloud when the matching key is set;
# force the offline libraries with "local".
# EMBED_BACKEND=local     # RAG embeddings: fastembed instead of Gemini
# STT_BACKEND=local       # speech-to-text: faster-whisper instead of Groq
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_STT_MODEL=whisper-large-v3-turbo
